+            root: Some(root),
+            ..Default::default()
+        };
+        for index in 0..count {
+            summary.add_entry(SubagentStatusEntry {
+                thread_id: ThreadId::new(),
+                name: format!("worker-{index:03}"),
+                state: SubagentState::Running,
+                task: Some("Checking focused tests".to_string()),
