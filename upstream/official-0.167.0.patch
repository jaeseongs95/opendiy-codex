+    {
+        use std::sync::atomic::Ordering;
+        let (mut app, _events, _ops) = crate::app::tests::make_test_app_with_channels().await;
+        let (session, _observed, worker) =
+            super::super::app_server_requests::retained_reply_tests::connection().await?;
