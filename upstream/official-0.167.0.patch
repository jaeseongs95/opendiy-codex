+    });
+    let (first, second) = tokio::join!(
+        handle(
+            &session,
+            request.clone(),
+            TurnInputMode::StartUserIfIdle,
+            "accepted-strict-a".into()
+        ),
+        handle(
+            &session,
+            request,
+            TurnInputMode::StartUserIfIdle,
+            "accepted-strict-b".into()
+        ),
+    );
+    let outcomes = [first.unwrap(), second.unwrap()];
