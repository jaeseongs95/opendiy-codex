+        // while the returned tree membership is still alive, and must not spawn rollback.
+        assert_eq!(Arc::strong_count(&state.cleanup_admission), baseline);
+        drop(membership);
+        assert_eq!(Arc::strong_count(&state.cleanup_admission), baseline);
+    }
