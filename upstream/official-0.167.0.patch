+                            *current = tool.clone();
+                        } else {
+                            existing
+                                .tools
+                                .push(DynamicToolNamespaceTool::Function(tool.clone()));
+                        }
+                    }
+                } else {
+                    merged.push(spec.clone());
+                }
+                for tool in &ns.tools {
+                    let DynamicToolNamespaceTool::Function(tool) = tool;
+                    keys.push((Some(ns.name.clone()), tool.name.clone()));
+                }
+            }
+        }
+    }
+    Ok((merged, keys))
+}
