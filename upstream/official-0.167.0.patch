+/// A preview binds confirmation to one runtime and one accepted-input revision.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CompletedChildSnapshot {
+    pub thread_id: ThreadId,
+    pub runtime_id: String,
+    pub activity_revision: u64,
+    pub last_turn_id: String,
+    pub terminal_status: String,
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CompletedChildCleanupResult {
+    pub thread_id: ThreadId,
+    pub outcome: String,
+    pub reason: String,
+    pub snapshot: Option<CompletedChildSnapshot>,
+}
+
+/// Pins one thread against cleanup while a host accepts durable work for it.
+pub struct ThreadActivityGuard {
+    _operation: CleanupOperation,
+}
+
+impl ThreadManager {
+    pub fn admit_thread_activity(&self, id: ThreadId) -> CodexResult<ThreadActivityGuard> {
+        Ok(ThreadActivityGuard {
+            _operation: self.state.cleanup_admission.admit([id])?,
+        })
+    }
+
+    /// Preview without restoring runtimes. Unverified, host-owned and active children are preserved.
+    pub async fn preview_completed_children(
+        &self,
+        parent: ThreadId,
+        current: ThreadId,
+    ) -> CodexResult<Vec<CompletedChildCleanupResult>> {
+        self.validate_cleanup_context(parent, current).await?;
+        let ids = self.list_agent_subtree_thread_ids(parent).await?;
+        let mut entries = Vec::new();
+        for id in ids.into_iter().filter(|id| *id != parent) {
+            let (snapshot, reason) = if id == current {
+                (None, "current_thread")
+            } else {
+                self.completed_child_snapshot(parent, id).await?
+            };
+            entries.push(CompletedChildCleanupResult {
+                thread_id: id,
+                outcome: if id == current {
+                    "protected"
+                } else if snapshot.is_some() {
+                    "eligible"
+                } else {
+                    "preserved"
+                }
+                .into(),
+                reason: reason.into(),
+                snapshot,
+            });
+        }
+        Ok(entries)
+    }
+
+    /// The owner task retains all Core fences if the request waiter disconnects.
+    /// The host must retain its durable queue and goal mutation guards through this call.
+    pub async fn cleanup_completed_children(
+        &self,
+        parent: ThreadId,
+        current: ThreadId,
+        selected: Vec<CompletedChildSnapshot>,
+    ) -> CodexResult<Vec<CompletedChildCleanupResult>> {
+        let manager = Self {
+            state: Arc::clone(&self.state),
+            _test_codex_home_guard: None,
+        };
+        tokio::spawn(async move {
+            manager
+                .cleanup_selected_children(parent, current, selected)
+                .await
+        })
+        .await?
+    }
+
+    async fn validate_cleanup_context(
+        &self,
+        parent: ThreadId,
+        current: ThreadId,
+    ) -> CodexResult<()> {
+        let parent_thread = self.get_thread(parent).await?;
+        let current_thread = self.get_thread(current).await?;
+        if self.state.agent_control_factory.is_some()
+            || !parent_thread.is_running()
+            || !current_thread.is_running()
+        {
+            return Err(CodexErr::InvalidRequest(
+                "cleanup requires loaded, locally owned parent and current runtimes".into(),
+            ));
+        }
+        if current != parent && current_thread.session_source.parent_thread_id() != Some(parent) {
+            return Err(CodexErr::InvalidRequest(
+                "current thread does not belong to the supplied parent".into(),
+            ));
+        }
+        // Compare actual runtime ownership rather than trusting client-provided UUIDs.
+        if !parent_thread
+            .session
+            .services
+            .local_agent_runtime
+            .shares_registry(&current_thread.session.services.local_agent_runtime)
+        {
+            return Err(CodexErr::InvalidRequest(
+                "current and parent runtime ownership differs".into(),
+            ));
+        }
+        Ok(())
+    }
+
+    async fn cleanup_owned_descendant(
+        &self,
+        parent: ThreadId,
+        mut id: ThreadId,
+    ) -> CodexResult<bool> {
+        let mut seen = HashSet::new();
+        while id != parent {
+            if !seen.insert(id) {
+                return Ok(false);
+            }
+            let stored = match self
+                .state
+                .read_stored_thread(ReadThreadParams {
+                    thread_id: id,
+                    include_archived: true,
+                    include_history: false,
+                })
+                .await
+            {
+                Ok(stored) => stored,
+                // An untouched live child may not have a saved record yet.
+                // Missing durable ancestry cannot authorize cleanup.
+                Err(error) if matches!(error.details(), CodexErrorDetails::ThreadNotFound(_)) => {
+                    return Ok(false);
+                }
+                Err(error) => return Err(error),
+            };
+            let Some(recorded_parent) = stored.parent_thread_id else {
+                return Ok(false);
+            };
+            if stored.source.parent_thread_id() != Some(recorded_parent) {
+                return Ok(false);
+            }
+            if let Ok(loaded) = self.get_thread(id).await {
+                if loaded.session_source.parent_thread_id() != Some(recorded_parent) {
+                    return Ok(false);
+                }
+            }
+            id = recorded_parent;
+        }
+        Ok(!seen.is_empty())
+    }
+
+    async fn completed_child_snapshot(
+        &self,
+        parent: ThreadId,
+        id: ThreadId,
+    ) -> CodexResult<(Option<CompletedChildSnapshot>, &'static str)> {
+        if !self.cleanup_owned_descendant(parent, id).await? {
+            return Ok((None, "ownership_unverified"));
+        }
+        let Ok(thread) = self.get_thread(id).await else {
+            if let Some(reason) = self
+                .state
+                .cleanup_admission
+                .unloaded_reference_block_reason()
+            {
+                return Ok((None, reason));
+            }
+            let Some(_reservation) = self.state.cleanup_admission.reserve(id) else {
+                return Ok((None, "busy"));
+            };
+            let Some(store) = self
+                .state
+                .thread_store
+                .as_any()
+                .downcast_ref::<LocalThreadStore>()
+            else {
+                return Ok((None, "unsupported_store"));
+            };
+            let guard = match store.reserve_unloaded_cleanup(id).await {
+                Ok(guard) => guard,
+                Err(
+                    codex_thread_store::ThreadStoreError::Conflict { .. }
+                    | codex_thread_store::ThreadStoreError::InvalidRequest { .. },
+                ) => return Ok((None, "writer_owned")),
+                Err(codex_thread_store::ThreadStoreError::Retryable { .. }) => {
+                    return Ok((None, "reference_publication_busy"));
+                }
+                Err(error) => {
+                    return Err(CodexErr::Fatal(format!(
+                        "failed to reserve unloaded child: {error}"
+                    )));
+                }
+            };
+            if self.get_thread(id).await.is_ok() {
+                return Ok((None, "changed"));
+            }
+            return self.unloaded_child_snapshot(parent, id, &guard).await;
+        };
+        let parent_thread = self.get_thread(parent).await?;
+        if self.state.agent_control_factory.is_some() {
+            return Ok((None, "host_owned"));
+        }
+        if thread.multi_agent_version() != Some(codex_protocol::protocol::MultiAgentVersion::V2) {
+            return Ok((None, "unsupported_generation"));
+        }
+        if !matches!(
+            thread.session_source,
+            SessionSource::SubAgent(SubAgentSource::ThreadSpawn { .. })
+        ) {
+            return Ok((None, "unsupported_source"));
+        }
+        if !parent_thread
+            .session
+            .services
+            .local_agent_runtime
+            .shares_registry(&thread.session.services.local_agent_runtime)
+        {
+            return Ok((None, "runtime_owner_mismatch"));
+        }
+        if thread.io.admission.is_closing() {
+            return Ok((None, "runtime_closing"));
+        }
+        let Ok(_gate) = Arc::clone(&thread.residency_gate).try_write_owned() else {
+            return Ok((None, "busy"));
+        };
+        self.completed_child_snapshot_under_gate(&thread).await
+    }
+
+    async fn completed_child_snapshot_under_gate(
+        &self,
+        thread: &Arc<CodexThread>,
+    ) -> CodexResult<(Option<CompletedChildSnapshot>, &'static str)> {
+        let id = thread.session.thread_id;
+        if !thread.cleanup_is_idle().await {
+            return Ok((None, "runtime_busy"));
+        }
+        if !matches!(
+            thread.agent_status().await,
+            AgentStatus::Completed(_) | AgentStatus::Errored(_) | AgentStatus::Interrupted
+        ) {
+            return Ok((None, "runtime_not_terminal"));
+        }
+        let Some(last_turn_id) = thread.session.cleanup_last_started_turn().await else {
+            return Ok((None, "terminal_turn_unverified"));
+        };
+        thread.flush_rollout().await?;
+        let stored = self
+            .state
+            .read_stored_thread(ReadThreadParams {
+                thread_id: id,
+                include_archived: true,
+                include_history: false,
+            })
+            .await?;
+        if stored.parent_thread_id != thread.session_source.parent_thread_id()
+            || stored.source.parent_thread_id() != stored.parent_thread_id
+            || stored.parent_thread_id.is_none()
+        {
+            return Ok((None, "ownership_unverified"));
+        }
+        let turns = self
+            .state
+            .thread_store
+            .list_turns(ListTurnsParams {
+                thread_id: id,
+                include_archived: true,
+                cursor: None,
+                page_size: 1,
+                sort_direction: SortDirection::Desc,
+                items_view: StoredTurnItemsView::NotLoaded,
+            })
+            .await
+            .map_err(|error| {
+                CodexErr::Fatal(format!("failed to verify terminal child turn: {error}"))
+            })?;
+        let Some(turn) = turns.turns.first() else {
+            return Ok((None, "terminal_turn_unverified"));
+        };
+        if turn.turn_id != last_turn_id {
+            return Ok((None, "terminal_turn_mismatch"));
+        }
+        let status = match turn.status {
+            StoredTurnStatus::Completed => "completed",
+            StoredTurnStatus::Failed => "failed",
+            StoredTurnStatus::Interrupted => "cancelled",
+            StoredTurnStatus::InProgress => return Ok((None, "terminal_turn_in_progress")),
+        };
+        Ok((
+            Some(CompletedChildSnapshot {
+                thread_id: id,
+                runtime_id: thread.io.admission.runtime_id.clone(),
+                activity_revision: thread.io.admission.revision.load(Ordering::Acquire),
+                last_turn_id,
+                terminal_status: status.into(),
+            }),
+            "loaded_terminal",
+        ))
+    }
+
+    async fn unloaded_child_snapshot(
+        &self,
+        parent: ThreadId,
+        id: ThreadId,
+        guard: &codex_thread_store::UnloadedThreadCleanupGuard,
+    ) -> CodexResult<(Option<CompletedChildSnapshot>, &'static str)> {
+        let parent_thread = self.get_thread(parent).await?;
+        if self.state.agent_graph_store().is_none() {
+            return Ok((None, "persistent_graph_unavailable"));
+        }
+        if parent_thread
+            .session
+            .services
+            .local_agent_runtime
+            .has_pending_cleanup_mail(id)
+        {
+            return Ok((None, "pending_agent_mail"));
+        }
+        let preview = guard.preview().await.map_err(|error| {
+            CodexErr::Fatal(format!("failed to verify unloaded child metadata: {error}"))
+        })?;
+        let Some(stored) = preview.snapshot else {
+            return Ok((None, preview.reason));
+        };
+        // Bind cold previews to this parent runtime generation and the exact durable file.
+        // The digest keeps local paths and file timestamps out of the public snapshot.
+        let revision = sha1::Sha1::digest(stored.revision.as_bytes());
+        Ok((
+            Some(CompletedChildSnapshot {
+                thread_id: id,
+                runtime_id: format!(
+                    "stored-v1:{}:{revision:x}",
+                    parent_thread.io.admission.runtime_id
+                ),
+                activity_revision: 0,
+                last_turn_id: stored.last_turn_id,
+                terminal_status: stored.terminal_status,
+            }),
+            "unloaded_terminal",
+        ))
+    }
+
+    async fn cleanup_selected_children(
+        &self,
+        parent: ThreadId,
+        current: ThreadId,
+        mut selected: Vec<CompletedChildSnapshot>,
+    ) -> CodexResult<Vec<CompletedChildCleanupResult>> {
+        self.validate_cleanup_context(parent, current).await?;
+        if self
+            .state
+            .thread_store
+            .as_any()
+            .downcast_ref::<LocalThreadStore>()
+            .is_none()
+        {
+            return Err(CodexErr::InvalidRequest(
+                "completed-child cleanup requires the local thread store".into(),
+            ));
+        }
+        let mut seen = HashSet::new();
+        if selected
+            .iter()
+            .any(|snapshot| !seen.insert(snapshot.thread_id))
+        {
+            return Err(CodexErr::InvalidRequest(
+                "duplicate cleanup selection".into(),
+            ));
+        }
+        // Retry only the fixed selection as successful leaf removal exposes selected parents.
+        let mut results = Vec::new();
+        while !selected.is_empty() {
+            let before = selected.len();
+            let mut deferred = Vec::new();
+            for expected in selected {
+                let id = expected.thread_id;
+                let result = self.cleanup_one_child(parent, current, &expected).await;
+                match result {
+                    Ok(outcome) if outcome == "has_descendants" => deferred.push(expected),
+                    Ok(outcome) => results.push(CompletedChildCleanupResult {
+                        thread_id: id,
+                        reason: outcome
+                            .split_once(": ")
+                            .map_or(outcome.as_str(), |(code, _)| code)
+                            .into(),
+                        outcome,
+                        snapshot: None,
+                    }),
+                    Err(error) => results.push(CompletedChildCleanupResult {
+                        thread_id: id,
+                        outcome: format!("unconfirmed: {error}"),
+                        reason: "unconfirmed".into(),
+                        snapshot: None,
+                    }),
+                }
+            }
+            if deferred.len() == before {
+                results.extend(
+                    deferred
+                        .into_iter()
+                        .map(|snapshot| CompletedChildCleanupResult {
+                            thread_id: snapshot.thread_id,
+                            outcome: "has_descendants".into(),
+                            reason: "has_descendants".into(),
+                            snapshot: None,
+                        }),
+                );
+                break;
+            }
+            selected = deferred;
+        }
+        Ok(results)
+    }
+
+    async fn cleanup_one_child(
+        &self,
+        parent: ThreadId,
+        current: ThreadId,
+        expected: &CompletedChildSnapshot,
+    ) -> CodexResult<String> {
+        let id = expected.thread_id;
+        if id == parent || id == current {
+            return Ok("protected".into());
+        }
+        let Some(mut reservation) = self.state.cleanup_admission.reserve(id) else {
+            return Ok("busy".into());
+        };
+        self.validate_cleanup_context(parent, current).await?;
+        if !self.cleanup_owned_descendant(parent, id).await?
+            || !self
+                .list_agent_subtree_thread_ids(parent)
+                .await?
+                .contains(&id)
+        {
+            return Ok("protected".into());
+        }
+        if self
+            .list_agent_subtree_thread_ids(id)
+            .await?
+            .iter()
+            .any(|child| *child != id)
+        {
+            return Ok("has_descendants".into());
+        }
+        let Ok(thread) = self.get_thread(id).await else {
+            if let Some(reason) = self
+                .state
+                .cleanup_admission
+                .unloaded_reference_block_reason()
+            {
+                return Ok(reason.into());
+            }
+            let Some(store) = self
+                .state
+                .thread_store
+                .as_any()
+                .downcast_ref::<LocalThreadStore>()
+            else {
+                return Ok("unsupported_store".into());
+            };
+            let guard = match store.reserve_unloaded_cleanup(id).await {
+                Ok(guard) => guard,
+                Err(
+                    codex_thread_store::ThreadStoreError::Conflict { .. }
+                    | codex_thread_store::ThreadStoreError::InvalidRequest { .. },
+                ) => return Ok("writer_owned".into()),
+                Err(codex_thread_store::ThreadStoreError::Retryable { .. }) => {
+                    return Ok("reference_publication_busy".into());
+                }
+                Err(error) => {
+                    return Err(CodexErr::Fatal(format!(
+                        "failed to reserve unloaded child: {error}"
+                    )));
+                }
+            };
+            if self.get_thread(id).await.is_ok() {
+                return Ok("changed".into());
+            }
+            let (actual, reason) = self.unloaded_child_snapshot(parent, id, &guard).await?;
+            if actual.as_ref() != Some(expected) {
+                return Ok(if actual.is_some() { "changed" } else { reason }.into());
+            }
+            // Recheck ancestry and the fixed leaf selection under writer ownership.
+            if !self.cleanup_owned_descendant(parent, id).await? {
+                return Ok("protected".into());
+            }
+            if self
+                .list_agent_subtree_thread_ids(id)
+                .await?
+                .iter()
+                .any(|child| *child != id)
+            {
+                return Ok("has_descendants".into());
+            }
+            let cleanup_runtime = self
+                .get_thread(parent)
+                .await?
+                .session
+                .services
+                .local_agent_runtime
+                .clone();
+            if let Err(error) = guard.delete(|| reservation.committed = true).await {
+                let outcome = if reservation.committed {
+                    "storage_unconfirmed_partial_deletion_possible"
+                } else {
+                    "storage_rejected_before_deletion"
+                };
+                return Ok(format!("{outcome}: {error}"));
+            }
+            cleanup_runtime.forget_cleaned_child(id);
+            return Ok("deleted".into());
+        };
+        let parent_thread = self.get_thread(parent).await?;
+        if thread.multi_agent_version() != Some(codex_protocol::protocol::MultiAgentVersion::V2)
+            || !matches!(
+                thread.session_source,
+                SessionSource::SubAgent(SubAgentSource::ThreadSpawn { .. })
+            )
+            || !parent_thread
+                .session
+                .services
+                .local_agent_runtime
+                .shares_registry(&thread.session.services.local_agent_runtime)
+        {
+            return Ok("protected".into());
+        }
+        let Ok(gate) = Arc::clone(&thread.residency_gate).try_write_owned() else {
+            return Ok("busy".into());
+        };
+        if self
+            .completed_child_snapshot_under_gate(&thread)
+            .await?
+            .0
+            .as_ref()
+            != Some(expected)
+        {
+            return Ok("changed".into());
+        }
+        if !self
+            .get_thread(id)
+            .await
+            .is_ok_and(|registered| Arc::ptr_eq(&registered, &thread))
+        {
+            return Ok("changed".into());
+        }
+        let local_cleanup = if let Some(store) = self
+            .state
+            .thread_store
+            .as_any()
+            .downcast_ref::<LocalThreadStore>()
+        {
+            match store.reserve_loaded_cleanup(id).await {
+                Ok(guard) => Some(guard),
+                Err(codex_thread_store::ThreadStoreError::Retryable { .. }) => {
+                    return Ok("reference_publication_busy".into());
+                }
+                Err(error) => return Ok(format!("storage_rejected_before_deletion: {error}")),
+            }
+        } else {
+            None
+        };
+        if !thread.session.close_for_cleanup().await {
+            return Ok("busy".into());
+        }
+        reservation.committed = true;
+        match tokio::time::timeout(
+            std::time::Duration::from_secs(30),
+            thread.io.shutdown_for_cleanup(&gate),
+        )
+        .await
+        {
+            Ok(Ok(())) if thread.io.admission.shutdown_confirmed() => {}
+            _ => return Ok("shutdown_unconfirmed".into()),
+        }
+        if !self
+            .get_thread(id)
+            .await
+            .is_ok_and(|registered| Arc::ptr_eq(&registered, &thread))
+            || self
+                .list_agent_subtree_thread_ids(id)
+                .await?
+                .iter()
+                .any(|child| *child != id)
+        {
+            return Ok("changed".into());
+        }
+        // Never expand this exact one-ID operation into a subtree deletion.
+        let deletion = if let Some(guard) = local_cleanup {
+            guard.delete().await
+        } else {
+            self.state
+                .thread_store
+                .delete_threads(DeleteThreadsParams {
+                    thread_ids: vec![id],
+                })
+                .await
+        };
+        if let Err(error) = deletion {
+            return Ok(format!(
+                "storage_unconfirmed_partial_deletion_possible: {error}"
+            ));
+        }
+        self.remove_thread_if_matches(&id, &thread).await;
+        thread
+            .session
+            .services
+            .local_agent_runtime
+            .forget_cleaned_child(id);
+        Ok("deleted".into())
+    }
+}
