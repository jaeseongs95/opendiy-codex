+fn selected(daemon: &Daemon, bytes: &[u8]) {
+    std::fs::create_dir_all(daemon.managed_codex_bin.parent().unwrap()).unwrap();
+    std::fs::write(&daemon.managed_codex_bin, bytes).unwrap();
+}
