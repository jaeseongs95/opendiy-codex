+        "{}\0\u{1f680}",
+        "한".repeat(crate::HISTORY_PAGE_TARGET_BYTES / 3 + 1)
+    );
+    let bytes = set_agent_payload(db, thread_id, "agent-2", &text).await;
+    let first = store
+        .list_items(item_params(
+            thread_id,
+            Some("turn"),
+            None,
+            100,
+            SortDirection::Asc,
+        ))
