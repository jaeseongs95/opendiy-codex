+        Ok(Some(status)) => std::process::exit(status.code().unwrap_or(1)),
+        Ok(None) => {}
+        Err(error) => {
+            eprintln!("OpenDIY launcher: {error:#}");
+            std::process::exit(1);
+        }
+    }
+}
