+        self
+    }
+
+    pub(crate) fn requires_owned_local_job(&self) -> bool {
+        self.require_owned_local_job
+    }
+
     pub(crate) fn local_process_cwd(&self) -> PathBuf {
         self.local_process_cwd.clone()
     }
