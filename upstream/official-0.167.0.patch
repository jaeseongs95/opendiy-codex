diff --git a/codex-rs/tui/src/cron.rs b/codex-rs/tui/src/cron.rs
new file mode 100644
index 000000000..37d39c60a
--- /dev/null
+++ b/codex-rs/tui/src/cron.rs
@@ -0,0 +1,646 @@
+//! Process-local scheduling. The caller supplies monotonic time and an immutable target.
+//! No worker, persistence, or fallback submission path lives here.
+use crate::i18n::text;
+use std::collections::BTreeSet;
+use std::time::Duration;
+use std::time::Instant;
+
+#[derive(Debug, Clone, Copy)]
+pub(crate) enum Schedule {
+    Every(Duration),
+    Once { deadline: Instant, at_unix_ms: u64 },
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Phase {
+    Ready,
+    Pending {
+        attempt: u64,
+        terminal_turns: BTreeSet<String>,
+    },
+    Running {
+        turn_id: String,
+        cancelling: bool,
+    },
+    Finished(String),
+    Unknown(String),
+    BlockedUnsupported(String),
+    BlockedConnection(String),
+}
+
+#[derive(Debug)]
+pub(crate) struct Job<T> {
+    pub(crate) id: u64,
+    pub(crate) target: T,
+    pub(crate) prompt: String,
+    pub(crate) schedule: Schedule,
+    pub(crate) phase: Phase,
+    pub(crate) paused: bool,
+    pub(crate) removed: bool,
+    pub(crate) skipped: u64,
+    pub(crate) next_due: Option<Instant>,
+    pub(crate) interval: Option<Duration>,
+    attempt: u64,
+}
+
+impl<T> Job<T> {
+    pub(crate) fn holds_target(&self) -> bool {
+        (!self.removed
+            && !matches!(
+                self.phase,
+                Phase::Finished(_) | Phase::BlockedUnsupported(_) | Phase::BlockedConnection(_)
+            ))
+            || matches!(
+                self.phase,
+                Phase::Pending { .. } | Phase::Running { .. } | Phase::Unknown(_)
+            )
+    }
+}
+
+#[derive(Debug)]
+pub(crate) enum Submission {
+    Started(String),
+    Busy,
+    NotStarted(String),
+    Unknown(String),
+}
+
+pub(crate) struct Dispatch<T> {
+    pub(crate) id: u64,
+    pub(crate) attempt: u64,
+    pub(crate) target: T,
+    pub(crate) prompt: String,
+}
+
+pub(crate) struct Scheduler<T> {
+    pub(crate) jobs: Vec<Job<T>>,
+    next_id: u64,
+}
+
+impl<T> Default for Scheduler<T> {
+    fn default() -> Self {
+        Self {
+            jobs: Vec::new(),
+            next_id: 1,
+        }
+    }
+}
+
+impl<T: Clone + PartialEq> Scheduler<T> {
+    pub(crate) fn add(
+        &mut self,
+        target: T,
+        prompt: String,
+        schedule: Schedule,
+        now: Instant,
+    ) -> Result<u64, String> {
+        if self.jobs.len() >= 100 {
+            return Err(text(
+                "At most 100 cron jobs are allowed, including removed jobs that still own a run.",
+            )
+            .into());
+        }
+        if prompt.trim().is_empty() || prompt.len() > 64 * 1024 || prompt.contains('\0') {
+            return Err(text(
+                "The cron prompt must be nonempty, contain no NUL, and be at most 64KiB.",
+            )
+            .into());
+        }
+        let (interval, next_due) = match schedule {
+            Schedule::Every(interval)
+                if !interval.is_zero()
+                    && (1..=9_007_199_254_740_991).contains(&interval.as_secs()) =>
+            {
+                (Some(interval), now.checked_add(interval))
+            }
+            Schedule::Every(_) => {
+                return Err(text("The cron interval must be greater than zero.").into());
+            }
+            Schedule::Once {
+                deadline,
+                at_unix_ms,
+            } if (1..=9_007_199_254_740_991).contains(&at_unix_ms) => (None, Some(deadline)),
+            Schedule::Once { .. } => {
+                return Err(text("The scheduled time is outside the supported range.").into());
+            }
+        };
+        let next_due = next_due.ok_or(text("The cron interval is too large."))?;
+        let id = self.next_id;
+        self.next_id = id
+            .checked_add(1)
+            .ok_or(text("No more cron job IDs are available."))?;
+        self.jobs.push(Job {
+            id,
+            target,
+            prompt,
+            schedule,
+            phase: Phase::Ready,
+            paused: false,
+            removed: false,
+            skipped: 0,
+            next_due: Some(next_due),
+            interval,
+            attempt: 0,
+        });
+        Ok(id)
+    }
+
+    pub(crate) fn job_mut(&mut self, id: u64) -> Result<&mut Job<T>, String> {
+        self.jobs
+            .iter_mut()
+            .find(|job| job.id == id)
+            .ok_or_else(|| text("Cron job {id} was not found.").replace("{id}", &id.to_string()))
+    }
+
+    pub(crate) fn next_deadline(&self) -> Option<Instant> {
+        self.jobs
+            .iter()
+            .filter(|job| {
+                !job.paused
+                    && !job.removed
+                    && !matches!(
+                        job.phase,
+                        Phase::Unknown(_)
+                            | Phase::BlockedUnsupported(_)
+                            | Phase::BlockedConnection(_)
+                    )
+            })
+            .filter_map(|job| job.next_due)
+            .min()
+    }
+
+    pub(crate) fn due(&mut self, now: Instant) -> Vec<Dispatch<T>> {
+        let mut dispatches = Vec::new();
+        for job in &mut self.jobs {
+            if job.paused
+                || job.removed
+                || matches!(
+                    job.phase,
+                    Phase::Unknown(_) | Phase::BlockedUnsupported(_) | Phase::BlockedConnection(_)
+                )
+                || job.next_due.is_none_or(|due| due > now)
+            {
+                continue;
+            }
+            // Missed slots are coalesced: at most one admission attempt, then a future slot.
+            job.next_due = job.interval.and_then(|interval| now.checked_add(interval));
+            if !matches!(job.phase, Phase::Ready) {
+                job.skipped = job.skipped.saturating_add(1);
+                continue;
+            }
+            job.attempt += 1;
+            job.phase = Phase::Pending {
+                attempt: job.attempt,
+                terminal_turns: BTreeSet::new(),
+            };
+            dispatches.push(Dispatch {
+                id: job.id,
+                attempt: job.attempt,
+                target: job.target.clone(),
+                prompt: job.prompt.clone(),
+            });
+        }
+        dispatches
+    }
+
+    pub(crate) fn submitted(&mut self, id: u64, attempt: u64, submission: Submission) -> bool {
+        let Ok(job) = self.job_mut(id) else {
+            return false;
+        };
+        let Phase::Pending {
+            attempt: expected,
+            terminal_turns,
+        } = &job.phase
+        else {
+            return false;
+        };
+        if *expected != attempt {
+            return false;
+        }
+        job.phase = match submission {
+            Submission::Started(turn_id) if terminal_turns.contains(&turn_id) => {
+                Self::after_terminal(job.interval, text("Finished"))
+            }
+            Submission::Started(turn_id) => Phase::Running {
+                turn_id,
+                cancelling: false,
+            },
+            Submission::Busy => {
+                job.skipped = job.skipped.saturating_add(1);
+                Self::after_terminal(job.interval, text("Target busy: skipped"))
+            }
+            Submission::NotStarted(reason) => {
+                job.paused = true;
+                Phase::Finished(format!("{} {reason}", text("Not admitted:")))
+            }
+            Submission::Unknown(reason) => Phase::Unknown(reason),
+        };
+        self.prune_removed();
+        true
+    }
+
+    fn after_terminal(interval: Option<Duration>, outcome: &str) -> Phase {
+        if interval.is_some() {
+            Phase::Ready
+        } else {
+            Phase::Finished(outcome.into())
+        }
+    }
+
+    pub(crate) fn terminal(&mut self, target: &T, turn_id: &str) {
+        for job in self.jobs.iter_mut().filter(|job| &job.target == target) {
+            match &mut job.phase {
+                Phase::Pending { terminal_turns, .. } => {
+                    terminal_turns.insert(turn_id.to_string());
+                }
+                Phase::Running { turn_id: owned, .. } if owned == turn_id => {
+                    job.phase = Self::after_terminal(job.interval, text("Finished"));
+                }
+                _ => {}
+            }
+        }
+        self.prune_removed();
+    }
+
+    pub(crate) fn remove(&mut self, id: u64) -> Result<(), String> {
+        self.job_mut(id)?.removed = true;
+        self.prune_removed();
+        Ok(())
+    }
+
+    fn prune_removed(&mut self) {
+        self.jobs.retain(|job| !job.removed || job.holds_target());
+    }
+
+    pub(crate) fn pause(&mut self, id: u64) -> Result<(), String> {
+        self.job_mut(id)?.paused = true;
+        Ok(())
+    }
+
+    pub(crate) fn resume(&mut self, id: u64, now: Instant) -> Result<(), String> {
+        let job = self.job_mut(id)?;
+        if job.removed {
+            return Err(text("A removed cron job cannot be resumed.").into());
+        }
+        if matches!(
+            job.phase,
+            Phase::Unknown(_)
+                | Phase::BlockedUnsupported(_)
+                | Phase::BlockedConnection(_)
+                | Phase::Pending { .. }
+        ) {
+            return Err(
+                text("The run state is unknown. It will not be retried automatically.").into(),
+            );
+        }
+        if matches!(job.phase, Phase::Finished(_)) && job.interval.is_none() {
+            return Err(text("This one-shot cron job has finished. Register a new job.").into());
+        }
+        job.paused = false;
+        if !matches!(job.phase, Phase::Running { .. }) {
+            job.phase = Phase::Ready;
+        }
+        job.next_due = Some(match job.interval {
+            Some(interval) => now
+                .checked_add(interval)
+                .ok_or(text("The cron interval is too large."))?,
+            None => job.next_due.unwrap_or(now).max(now),
+        });
+        Ok(())
+    }
+
+    pub(crate) fn block_unsupported(&mut self, target_matches: impl Fn(&T) -> bool) {
+        for job in self
+            .jobs
+            .iter_mut()
+            .filter(|job| target_matches(&job.target))
+        {
+            job.phase =
+                Phase::BlockedUnsupported(text("turn/startIfIdle unsupported: not run").into());
+            job.next_due = None;
+        }
+    }
+
+    pub(crate) fn invalidate(&mut self, target_matches: impl Fn(&T) -> bool, reason: &str) {
+        for job in self
+            .jobs
+            .iter_mut()
+            .filter(|job| target_matches(&job.target))
+        {
+            job.phase = match &job.phase {
+                Phase::Pending { .. } | Phase::Running { .. } | Phase::Unknown(_) => {
+                    Phase::Unknown(reason.into())
+                }
+                Phase::Finished(_) | Phase::BlockedUnsupported(_) => continue,
+                _ => Phase::BlockedConnection(reason.into()),
+            };
+            job.next_due = None;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
