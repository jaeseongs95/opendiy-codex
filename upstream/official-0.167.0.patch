+
+    fn render_panel(
+        panel: &SubagentStatusPanel,
+        width: u16,
+        allow_expanded: bool,
+    ) -> (u16, String) {
+        let view = panel.view(allow_expanded);
+        let height = view.desired_height(width);
+        let area = Rect::new(0, 0, width, height);
+        let mut buffer = Buffer::empty(area);
