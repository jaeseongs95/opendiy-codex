+        let required = schema["required"].as_array().unwrap();
+        assert!(required.contains(&json!("expectedRuntimeId")));
+        let types = schema["properties"]["expectedRuntimeId"]["type"]
+            .as_array()
+            .unwrap();
+        assert_eq!(types.len(), 2);
