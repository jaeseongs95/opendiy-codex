+    fn shutdown_result(&self) -> CodexResult<()> {
+        // The original loop failure remains in the shared outcome. Shutdown only
+        // confirms resource release, so a fully cleaned failed loop can be unloaded.
+        if matches!(
+            self,
+            Self::Loop {
+                cleanup_confirmed: true,
+                ..
+            }
+        ) {
