+            text.replacen(
+                "\"promptPreview\":",
+                "\"prompt\":\"원문 유출 금지\",\"promptPreview\":",
+                1,
+            ),
+        ] {
+            assert!(from_json::<Response>(broken.as_bytes()).is_err());
+        }
+    }
