+            ),
+            (
+                "turn/startUserIfIdle",
+                json!({"threadId":"loaded-thread","input":[]}),
+            ),
+        ] {
+            let request: ClientRequest = serde_json::from_value(json!({
+                "id":1,"method":method,"params":params
+            }))
+            .unwrap();
+            assert_eq!(request.experimental_reason(), None, "{method}");
+        }
+
