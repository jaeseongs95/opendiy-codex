+                    "도움말 표시"
+                ),
+                "long" => assert_eq!(
+                    after.get_long_help().expect("long help").to_string(),
+                    "버전 표시"
+                ),
+                "both" => {
+                    assert_eq!(
+                        after.get_help().expect("short help").to_string(),
+                        "custom short"
+                    );
+                    assert_eq!(
+                        after.get_long_help().expect("long help").to_string(),
+                        "custom long"
+                    );
+                }
+                _ => {}
+            }
+        }
