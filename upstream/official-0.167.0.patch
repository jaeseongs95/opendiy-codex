+
+async fn fixture_with_graph_options(
+    graph: Option<Arc<dyn codex_agent_graph_store::AgentGraphStore>>,
+    persistent_graph: bool,
+) -> (
+    (
+        tempfile::TempDir,
+        ThreadManager,
+        crate::config::Config,
+        super::super::NewThread,
+    ),
+    Arc<StoreFaults>,
+) {
+    let home = tempfile::tempdir().unwrap();
+    let mut config = crate::config::test_config().await;
+    config.codex_home = home.path().to_path_buf().try_into().unwrap();
+    config.cwd = home.path().to_path_buf().try_into().unwrap();
+    config.sqlite = codex_state::SqliteConfig::new_for_testing(config.codex_home.clone());
+    config
+        .features
+        .enable(codex_features::Feature::Sqlite)
+        .unwrap();
+    let _ = config
+        .features
+        .enable(codex_features::Feature::MultiAgentV2);
+    let _ = config
+        .features
+        .disable(codex_features::Feature::WakeOnAgentMessages);
+    config.model_catalog = Some(codex_models_manager::bundled_models_response().unwrap());
+    // Paginated terminal verification needs the same real metadata database as
+    // the local recorder. A store without it deliberately rejects list_turns.
+    let state_db = crate::init_state_db(&config)
+        .await
+        .expect("isolated cleanup fixture metadata database");
+    let mut manager = ThreadManager::with_models_provider_home_and_state_for_tests(
+        codex_login::CodexAuth::from_api_key("dummy"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+        Some(Arc::clone(&state_db)),
+    );
+    let faults = Arc::new(StoreFaults::default());
+    let state = Arc::get_mut(&mut manager.state).unwrap();
+    let cleanup_faults = Arc::clone(&faults);
+    let before_delete_faults = Arc::clone(&faults);
+    let after_delete_faults = Arc::clone(&faults);
+    let local = state
+        .thread_store
+        .as_any()
+        .downcast_ref::<LocalThreadStore>()
+        .unwrap()
+        .clone()
+        .with_loaded_cleanup_delete_hooks_for_test(
+            move |id| {
+                let faults = Arc::clone(&before_delete_faults);
+                Box::pin(async move {
+                    faults.deletes.lock().unwrap().push(vec![id]);
+                    let barrier = faults
+                        .delete
+                        .lock()
+                        .unwrap()
+                        .as_ref()
+                        .filter(|(target, _)| *target == id)
+                        .map(|(_, barrier)| Arc::clone(barrier));
+                    if let Some(barrier) = barrier {
+                        barrier.block().await;
+                    }
+                    if faults.fail_delete.lock().unwrap().contains(&id) {
+                        return Err(store::ThreadStoreError::Retryable {
+                            message: "injected deletion failure before commit".into(),
+                        });
+                    }
+                    Ok(())
+                })
+            },
+            move |id| {
+                let faults = Arc::clone(&after_delete_faults);
+                Box::pin(async move {
+                    let barrier = {
+                        let mut slot = faults.delete.lock().unwrap();
+                        if slot.as_ref().is_some_and(|(target, _)| *target == id) {
+                            slot.take().map(|(_, barrier)| barrier)
+                        } else {
+                            None
+                        }
+                    };
+                    if let Some(barrier) = barrier {
+                        barrier.finished.notify_one();
+                    }
+                    let after = {
+                        let mut slot = faults.after_delete.lock().unwrap();
+                        if slot.as_ref().is_some_and(|(target, _)| *target == id) {
+                            slot.take().map(|(_, barrier)| barrier)
+                        } else {
+                            None
+                        }
+                    };
+                    if let Some(after) = after {
+                        after.block().await;
+                        after.finished.notify_one();
+                    }
+                    if faults.lose_delete_response.lock().unwrap().contains(&id) {
+                        return Err(store::ThreadStoreError::OutcomeUnknown {
+                            message: "injected response loss after actual local deletion".into(),
+                        });
+                    }
+                    Ok(())
+                })
+            },
+        )
+        .with_thread_data_cleanup(move |ids| {
+            let faults = Arc::clone(&cleanup_faults);
+            Box::pin(async move {
+                let barrier = {
+                    let mut slot = faults.cold_delete.lock().unwrap();
+                    if slot.as_ref().is_some_and(|(id, _)| ids == [*id]) {
+                        slot.take().map(|(_, barrier)| barrier)
+                    } else {
+                        None
+                    }
+                };
+                if let Some(barrier) = barrier {
+                    barrier.block().await;
+                    barrier.finished.notify_one();
+                }
+                if ids
+                    .iter()
+                    .any(|id| faults.fail_cold_cleanup.lock().unwrap().contains(id))
+                {
+                    return Err(store::ThreadStoreError::OutcomeUnknown {
+                        message: "injected host cleanup failure after mutation boundary".into(),
+                    });
+                }
+                Ok(())
+            })
+        });
+    state.thread_store = Arc::new(FaultStore {
+        inner: Arc::new(local),
+        faults: Arc::clone(&faults),
+    });
+    state.agent_graph_store = if persistent_graph {
+        Some(Arc::new(
+            codex_agent_graph_store::LocalAgentGraphStore::new(state_db),
+        ))
+    } else {
+        graph
+    };
+    let root = manager
+        .start_thread(StartThreadOptions::new(config.clone()))
+        .await
+        .unwrap();
+    root.thread.ensure_rollout_materialized().await;
+    ((home, manager, config, root), faults)
+}
+
+async fn child(
+    manager: &ThreadManager,
+    config: &crate::config::Config,
+    parent: &super::super::NewThread,
+) -> super::super::NewThread {
+    manager
+        .state
+        .spawn_child_thread(
+            StartThreadOptions {
+                session_source: Some(SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                    parent_thread_id: parent.thread_id,
+                    depth: 1,
+                    agent_path: None,
+                    agent_nickname: None,
+                    agent_role: None,
+                })),
+                ..StartThreadOptions::new(config.clone())
+            },
+            parent
+                .thread
+                .session
+                .services
+                .local_agent_runtime
+                .control(parent.thread.session.session_id()),
+            Some(parent.thread_id),
+            None,
+        )
+        .await
+        .unwrap()
+}
+
+async fn complete(thread: &Arc<CodexThread>) {
+    use codex_protocol::protocol::EventMsg;
+    use codex_protocol::protocol::TurnCompleteEvent;
+    use codex_protocol::protocol::TurnStartedEvent;
+    let turn = thread.session.new_default_turn().await;
+    thread.session.record_started_turn(&turn.sub_id, None).await;
+    thread
+        .session
+        .send_event(
+            &turn,
+            EventMsg::TurnStarted(TurnStartedEvent {
+                turn_id: turn.sub_id.clone(),
+                root_turn_id: None,
+                model_context_window: None,
+                turn_attribution: None,
+                trace_id: None,
+                started_at: None,
+                collaboration_mode_kind: Default::default(),
+            }),
+        )
+        .await;
+    thread
+        .session
+        .send_event(
+            &turn,
+            EventMsg::TurnComplete(TurnCompleteEvent {
+                root_turn_id: None,
+                turn_id: turn.sub_id.clone(),
+                started_at: None,
+                last_agent_message: Some("done".into()),
+                error: None,
+                completed_at: None,
+                duration_ms: None,
+                time_to_first_token_ms: None,
+            }),
+        )
+        .await;
+    *thread.session.active_turn.lock().await = None;
+    thread.flush_rollout().await.unwrap();
+}
