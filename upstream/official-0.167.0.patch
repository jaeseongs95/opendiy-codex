+async fn fixture_with_graph(
+    graph: Option<Arc<dyn codex_agent_graph_store::AgentGraphStore>>,
+) -> (
+    (
+        tempfile::TempDir,
+        ThreadManager,
+        crate::config::Config,
+        super::super::NewThread,
+    ),
