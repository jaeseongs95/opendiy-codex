+        .await
+        .as_ref()
+        .unwrap()
+        .task
+        .as_ref()
+        .unwrap()
+        .cancellation_token
+        .clone();
+    let communication = codex_protocol::protocol::InterAgentCommunication::new(
+        codex_protocol::AgentPath::root(),
