+fn localized_warning_copy_hint_uses_action_id_and_keeps_remapped_copy() {
+    for (locale, label) in [
+        (crate::i18n::Locale::English, "copy"),
+        (crate::i18n::Locale::Korean, "복사"),
+    ] {
