+async fn read_only_process_matches(record: &PidRecord) -> Result<bool> {
+    let Some(process) = super::windows::Process::open(record.pid)? else {
+        return Ok(false);
+    };
+    if !process.is_running()? {
+        return Ok(false);
+    }
+    anyhow::ensure!(
