+            && let TurnItem::UserMessage(item) = &mut completed.item
+        {
+            item.content = vec![CoreUserInput::Text {
+                text: "x".repeat(size),
+                text_elements: Vec::new(),
+            }];
+            record["payload"] = serde_json::to_value(event)?;
