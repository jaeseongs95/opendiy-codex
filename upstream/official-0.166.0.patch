+        assert!(matches!(app.cron.scheduler.jobs[0].phase, Phase::Ready));
+        assert_eq!(app.cron.model_calls.len(), 1);
+        assert!(
+            other_connection
+                .live
+                .load(std::sync::atomic::Ordering::Acquire)
