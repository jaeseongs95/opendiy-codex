+        let mut prepared = prepared;
+        // 시험은 접근 불가능할 수 있는 Store 별칭 대신 실제 시스템 셸을 사용한다.
+        // 모델의 shell 인자는 원래 경로가 아니라 셸 종류를 선택한다.
+        let shell_path =
+            std::path::PathBuf::from(std::env::var_os("SystemRoot").expect("Windows system root"))
+                .join("System32/WindowsPowerShell/v1.0/powershell.exe");
+        assert!(shell_path.is_file(), "system PowerShell executable");
+        prepared.resolved.shell.shell.shell_path = shell_path.clone();
+        prepared.resolved.command[0] = shell_path.to_string_lossy().into_owned();
+        prepared
+            .resolved
+            .command
+            .splice(1..1, ["-WindowStyle".to_string(), "Hidden".to_string()]);
+        prepared
+    };
+    let request = ExecCommandRequest {
+        prepared,
+        process_id,
+        network: None,
+    };
+    let signal = async {
+        let process = tokio::time::timeout(Duration::from_secs(5), async {
+            loop {
+                let process = manager
+                    .process_store
+                    .lock()
+                    .await
+                    .processes
+                    .get(&process_id)
+                    .map(|entry| Arc::clone(&entry.process));
+                if let Some(process) = process {
+                    let ready = process
+                        .output_handles()
+                        .output_buffer
+                        .lock()
+                        .await
+                        .transcript
+                        .to_bytes_with_omission_marker()
+                        .windows(7)
+                        .any(|part| part == b"before:");
+                    if ready {
+                        break process;
+                    }
+                }
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("spawned shell output");
+        assert!(
+            manager
+                .request_initial_yield(codex_protocol::ThreadId::new(), "startup-owned", process_id)
+                .await
+                .is_err()
+        );
+        assert!(
+            manager
+                .request_initial_yield(session.thread_id(), "stale-call", process_id)
+                .await
+                .is_err()
+        );
+        manager
+            .request_initial_yield(session.thread_id(), "startup-owned", process_id)
+            .await
+            .expect("yield exact owner");
+        // A duplicate either reaches the same request token or observes startup already returned.
+        let _duplicate = manager
+            .request_initial_yield(session.thread_id(), "startup-owned", process_id)
+            .await;
+        process
+    };
+    let exec = manager.exec_command(request, &context);
+    tokio::pin!(exec);
+    let process = tokio::select! {
+        biased;
+        response = &mut exec => panic!("exec_command returned before startup yield: {response:?}"),
+        process = signal => process,
+    };
+    let response = exec.await.expect("normal tool response");
+    assert_eq!(response.process_id, Some(process_id));
+    assert_eq!(response.exit_code, None);
+    let before = response.raw_output.text.as_str();
+    let spawned_pid =
+        std::fs::read_to_string(temp.path().join("spawn-count")).expect("spawn witness");
+    assert_eq!(spawned_pid.lines().count(), 1);
+    let pid = spawned_pid.trim();
+    assert!(
+        before.contains(&format!("before:{pid}:preserved:tty")),
+        "{before}"
+    );
+    assert!(!process.has_exited());
+    {
+        let store = manager.process_store.lock().await;
+        assert!(Arc::ptr_eq(
+            &store
+                .processes
+                .get(&process_id)
+                .expect("same process")
+                .process,
+            &process
+        ));
+    }
+    assert!(
+        manager
+            .request_initial_yield(session.thread_id(), "startup-owned", process_id)
+            .await
+            .is_err()
+    );
+    let terminal = manager
+        .resolve_terminal(process_id)
+        .await
+        .expect("retained terminal");
+    let after = manager
+        .write_stdin(
+            &context,
+            WriteStdinRequest {
+                terminal: &terminal,
+                input: if cfg!(windows) {
+                    "continued\r"
+                } else {
+                    "continued\n"
+                },
+                yield_time_ms: 1000,
+                max_output_tokens: None,
+                truncation_policy: codex_utils_output_truncation::TruncationPolicy::Tokens(10_000),
+                interaction_event: None,
+            },
+        )
+        .await
+        .expect("write same terminal");
+    let after_text = after.raw_output.text.as_str();
+    assert!(
+        after_text.contains(&format!("after:{pid}:preserved:continued")),
+        "{after_text}"
+    );
+    assert_eq!(
+        std::fs::read_to_string(temp.path().join("spawn-count")).expect("spawn witness"),
+        spawned_pid
+    );
+    assert_eq!(after.process_id, Some(process_id));
+    assert!(!process.has_exited());
+    assert!(manager.terminate_process(process_id).await);
+    assert!(process.has_exited());
+    assert!(manager.resolve_terminal(process_id).await.is_err());
+}
