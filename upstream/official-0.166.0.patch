+        r#"{"name":"sample"}"#,
+    )?;
+    let store = codex_core_plugins::store::PluginStore::new(home.to_path_buf());
+    let plugin_id = codex_plugin::PluginId::parse("sample@test")?;
+    store.install(
+        AbsolutePathBuf::try_from(source.path().to_path_buf())?,
