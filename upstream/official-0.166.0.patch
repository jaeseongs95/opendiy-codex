+fn fault_owner(key: LocalLaunchKey, fault: Arc<CleanupFault>) -> StdioServerProcessHandle {
+    let child = Arc::new(tokio::sync::Mutex::new(Box::new(LocalChildProcess::Fault(
+        fault,
+    ))));
+    StdioServerProcessHandle::local(
+        "fixture".into(),
