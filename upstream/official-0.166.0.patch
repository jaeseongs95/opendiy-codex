+                    Op::TurnInput {
+                        request: Box::new(TurnInputRequest::user_input(input)),
+                        mode: TurnInputMode::StartOrSteer,
+                        reply,
+                    },
+                )
+                .is_err()
+                {
+                    return Ok(Outcome::NotApplied);
+                }
+                drop(threads);
