+                "session loop {}; cleanup {}{}",
+                if source.is_panic() {
+                    "panicked"
+                } else {
+                    "was cancelled"
+                },
+                if *cleanup_confirmed {
+                    "confirmed"
+                } else {
+                    "unconfirmed"
+                },
