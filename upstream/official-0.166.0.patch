+        let (request, response) = model_request(
+            other_connection,
+            other,
+            "accepted-list",
+            "add --every 2m -- 변경 거부",
+        );
+        app.handle_cron_tool_call(
+            backends.session_at(backends.slot(request.connection.backend).unwrap()),
+            request,
+        )
+        .await;
+        assert!(!response.await?.success);
+        backends.shutdown().await?;
+        survivor_worker.await??;
+        Ok(())
+    }
