+                thread_id: target.thread_id.to_string(),
+                exclude_turns: true,
+                ..Default::default()
+            },
+        })
+        .await?;
+    let mut thread = server.thread_read(target.thread_id, false).await?;
+    server
+        .hydrate_initial_thread_history(
