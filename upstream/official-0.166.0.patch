+                    if content.iter().any(|part| matches!(part, codex_protocol::models::ContentItem::InputText { text }
+                        if text.contains("<turn_aborted>"))))
+            }));
+            session.abort_all_tasks(TurnAbortReason::Replaced).await;
+        }
+    }
