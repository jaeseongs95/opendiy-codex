+
+#[cfg(test)]
+mod shutdown_failure_tests {
+    use super::*;
+    use std::sync::atomic::AtomicUsize;
+    use std::sync::atomic::Ordering;
+    use tokio::sync::Notify;
+
+    #[tokio::test]
+    async fn final_lease_retains_cleanup_result_when_a_shutdown_waiter_is_cancelled() {
+        for succeeds in [false, true] {
+            let release = Arc::new(Notify::new());
+            let started = Arc::new(Notify::new());
+            let cleanups = Arc::new(AtomicUsize::new(0));
+            let cleanup = {
+                let release = Arc::clone(&release);
+                let started = Arc::clone(&started);
+                let cleanups = Arc::clone(&cleanups);
+                async move {
+                    cleanups.fetch_add(1, Ordering::SeqCst);
+                    started.notify_one();
+                    release.notified().await;
+                    if succeeds {
+                        Ok(())
+                    } else {
+                        Err("injected cleanup failure".to_string())
+                    }
+                }
+                .boxed()
+                .shared()
+            };
+            let owners = Arc::new(LeaseOwners);
+            let entry = Arc::new(Entry {
+                key: tests::key(&tests::context(), &tests::config()),
+                client: futures::future::ready(Err(StartupOutcomeError::Failed {
+                    error: "startup failed".to_string(),
+                    is_authentication_required: false,
+                    is_ema_authentication_required: false,
+                    is_termination_unconfirmed: false,
+                    shutdown: Some(cleanup),
+                }))
+                .boxed()
+                .shared(),
+                capabilities: Arc::default(),
+                catalog: Mutex::new(None),
+                cancellation: CancellationToken::new(),
+                sharing_declined: CancellationToken::new(),
+                owners: Arc::downgrade(&owners),
+                pool: Weak::new(),
+            });
+            let first = ConnectionLease {
+                entry: Arc::clone(&entry),
+                owner: Mutex::new(Some(Arc::clone(&owners))),
+                cancellation: CancellationToken::new(),
+                slot: Arc::default(),
+            };
+            let last_slot = Arc::new(ConnectionSlot::default());
+            let last = ConnectionLease {
+                entry: Arc::clone(&entry),
+                owner: Mutex::new(Some(owners)),
+                cancellation: CancellationToken::new(),
+                slot: Arc::clone(&last_slot),
+            };
+            assert!(
+                first.release().is_none(),
+                "another chat still owns the connection"
+            );
+            assert!(!entry.cancellation.is_cancelled());
+            assert_eq!(cleanups.load(Ordering::SeqCst), 0);
+            assert!(last.release().is_some());
+            assert!(entry.cancellation.is_cancelled());
+            let waiter = {
+                let slot = Arc::clone(&last_slot);
+                tokio::spawn(async move { slot.wait_for_shutdown().await })
+            };
+            tokio::time::timeout(Duration::from_secs(5), started.notified())
+                .await
+                .unwrap();
+            waiter.abort();
+            release.notify_one();
+            let result =
+                tokio::time::timeout(Duration::from_secs(5), last_slot.wait_for_shutdown())
+                    .await
+                    .unwrap();
+            assert_eq!(result.is_ok(), succeeds);
+            if let Err(error) = result {
+                assert!(error.to_string().contains("injected cleanup failure"));
+            }
+            assert_eq!(last_slot.wait_for_shutdown().await.is_ok(), succeeds);
+            assert!(last.release().is_none());
+            assert_eq!(cleanups.load(Ordering::SeqCst), 1);
+        }
+    }
+}
