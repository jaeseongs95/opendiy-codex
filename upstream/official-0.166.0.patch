+        if let CronRequest::Add { prompt, .. } = &mut changed {
+            prompt.push(' ');
+        }
+        assert_ne!(
+            receipt_fingerprint(&scope(), &add()).unwrap(),
+            receipt_fingerprint(&scope(), &changed).unwrap()
+        );
