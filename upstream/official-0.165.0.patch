+        let starts = events
+            .iter()
+            .filter_map(|event| match &event.payload {
+                RawTraceEventPayload::InferenceStarted {
+                    inference_call_id, ..
+                } => Some(inference_call_id),
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        let cancelled = events
+            .iter()
+            .filter_map(|event| match &event.payload {
+                RawTraceEventPayload::InferenceCancelled {
+                    inference_call_id,
+                    reason,
+                    ..
+                } => {
