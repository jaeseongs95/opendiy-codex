+async fn set_agent_payload(
+    db: &sqlx::SqlitePool,
+    thread_id: ThreadId,
+    item_id: &str,
+    text: &str,
+) -> usize {
+    let json =
+        serde_json::json!({ "type": "agentMessage", "id": item_id, "text": text }).to_string();
+    let bytes = json.len();
+    sqlx::query("UPDATE thread_items SET item_json = ? WHERE thread_id = ? AND item_id = ?")
+        .bind(json)
+        .bind(thread_id.to_string())
+        .bind(item_id)
+        .execute(db)
+        .await
+        .unwrap();
+    bytes
+}
