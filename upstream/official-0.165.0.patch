+                tracing::subscriber::with_default(capture, || process_responses_event(event));
+            assert!(matches!(
+                result,
+                Ok(Some(ResponseEvent::Created { .. }))
+                    | Ok(Some(ResponseEvent::Completed {
+                        end_turn: Some(false),
+                        ..
+                    }))
+            ));
+            assert!(events.lock().unwrap().is_empty());
+        }
+    }
+}
