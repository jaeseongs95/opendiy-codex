+                    } else {
+                        turn.items.first()
+                    }
+                })
+                .map(|item| {
+                    ThreadItemsListCursor::Anchor(ThreadItemsListAnchor::Item {
+                        item_id: item.id().to_string(),
+                    })
+                })
