+            temp.path(),
+            "trace-1".into(),
+            "rollout-1".into(),
+            "thread-root".into(),
+        )?);
+        writer.append(RawTraceEventPayload::ThreadStarted {
+            thread_id: "thread-root".into(),
+            agent_path: "/root".into(),
+            metadata_payload: None,
+        })?;
+        writer.append(RawTraceEventPayload::CodexTurnStarted {
