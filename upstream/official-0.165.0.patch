+    let (release, gate) = tokio::sync::oneshot::channel();
+    let mut release = Some(release);
+    let (server, _) = start_streaming_sse_server(vec![
+        vec![StreamingSseChunk {
+            gate: None,
+            body: responses::sse(vec![overload()]),
