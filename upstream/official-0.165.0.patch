+            .extend(extra.as_object().unwrap().clone());
+        send(
+            &processor,
+            id,
+            &session,
+            json!({"id":n,"method":"turn/startUserIfIdle","params":params}),
+        )
+        .await;
+        assert!(error(&mut rx, id, n).await.contains("turn/startUserIfIdle"));
+    }
+    assert_eq!(
+        processor
+            .thread_processor
+            .thread_manager
+            .list_thread_ids()
+            .await
+            .len(),
+        1
+    );
+    finish(&processor, rx).await;
+    Ok(())
+}
