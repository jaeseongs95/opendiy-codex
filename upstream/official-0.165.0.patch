@@ -0,0 +1,227 @@
+//! Targeted reload never retargets a queued command or falls back to global config mutation.
+
+use super::session_lifecycle_requests::{
+    HistoryCapabilities, recorded_params, start_recording_app_server_with_history,
+};
+use super::*;
+use crate::app::session_lifecycle::ThreadAttachPresentation;
+use crate::app_server_session::ResumeModelSettings;
+use crate::app_server_session::ThreadParamsMode;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn reload_plugin_routes_captured_thread_and_unsupported_backend_fails_closed() -> Result<()> {
+    for capabilities in [
+        HistoryCapabilities::Current,
+        HistoryCapabilities::PluginReloadUnsupported,
+    ] {
+        let (mut app, mut events, _) = make_test_app_with_channels().await;
+        let (mut server, requests, proxy) = start_recording_app_server_with_history(
+            &app.config,
+            capabilities,
+            None,
+            None,
+            ThreadParamsMode::Embedded,
+            LoaderOverrides::without_managed_config_for_tests(),
+        )
+        .await?;
+        let started = server.start_thread(&app.config).await?;
+        let original = started.session.thread_id;
+        app.enqueue_primary_thread_session(started.session, started.turns)
+            .await?;
+        let command = queued_reload_plugin(&mut app, &mut events);
+        app.chat_widget
+            .restore_user_message_to_composer("retained draft".into());
+        requests.lock().unwrap().clear();
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        app.handle_event(&mut tui, &mut server, command).await?;
+        let reloads = recorded_params(&requests, "thread/plugin/reload");
+        assert_eq!(reloads.len(), 1);
+        assert_eq!(reloads[0]["threadId"], original.to_string());
+        for forbidden in [
+            "config/batchWrite",
+            "config/mcpServer/reload",
+            "turn/start",
+            "turn/steer",
+            "turn/interrupt",
+        ] {
+            assert!(
+                recorded_params(&requests, forbidden).is_empty(),
+                "{forbidden}"
+            );
+        }
+        assert_eq!(
+            app.chat_widget.composer_text_with_pending(),
+            "retained draft"
+        );
+        let history = next_history_message(&mut events);
+        if capabilities == HistoryCapabilities::Current {
+            assert!(history.contains("MCP reconnect requested"));
+            assert!(history.contains("confirmed"));
+        } else {
+            assert!(history.contains("Plugin reload failed"));
+            assert!(history.contains("method not found"));
+        }
+        proxy.abort();
+    }
+    Ok(())
+}
+
+/// Exercise the actual slash parser and event queue, retaining the command across a UI handoff.
+fn queued_reload_plugin(
+    app: &mut App,
+    events: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) -> AppEvent {
+    queued_runtime_command(app, events, "/reload_plugin")
+}
+
+fn queued_runtime_command(
+    app: &mut App,
+    events: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+    command: &str,
+) -> AppEvent {
+    while events.try_recv().is_ok() {}
+    app.chat_widget.insert_str(command);
+    app.chat_widget.handle_key_event(KeyCode::Esc.into());
+    app.chat_widget.handle_key_event(KeyCode::Enter.into());
+    std::iter::from_fn(|| events.try_recv().ok())
+        .find(|event| {
+            matches!(
+                event,
+                AppEvent::SubmitThreadOp {
+                    op: Op::ReloadPlugins { .. } | Op::SelectServiceTier { .. },
+                    ..
+                }
+            )
+        })
+        .expect("slash command enqueues a captured runtime owner")
+}
+
+#[tokio::test]
+async fn reload_plugin_and_fast_queued_before_screen_or_backend_replacement_sends_zero_rpcs()
+-> Result<()> {
+    // Same-backend navigation is intentionally rejected too; users can issue a new command.
+    for (switch_backend, command, stale_error) in [
+        (false, "/reload_plugin", "Stale plugin reload"),
+        (true, "/reload_plugin", "Stale plugin reload"),
+        (false, "/fast", "Stale service tier selection"),
+        (true, "/fast", "Stale service tier selection"),
+    ] {
+        let (mut app, mut events, _) = make_test_app_with_channels().await;
+        let timestamp = "2026-01-01T00-00-00";
+        let saved = app_test_support::create_fake_rollout(
+            app.config.codex_home.as_path(),
+            timestamp,
+            "2026-01-01T00:00:00Z",
+            "reload owner fixture",
+            Some(&app.config.model_provider_id),
+            None,
+        )
+        .expect("saved rollout");
+        let id = ThreadId::from_string(&saved)?;
+        let other_home = tempdir()?;
+        let mut other_config = app.config.clone();
+        other_config.codex_home = other_home.path().to_path_buf().abs();
+        other_config.sqlite = codex_state::SqliteConfig::new_for_testing(other_home.path().abs());
+        // Independent homes avoid shared writer leases while deliberately reusing the native UUID.
+        let source =
+            app_test_support::rollout_path(app.config.codex_home.as_path(), timestamp, &saved);
+        let destination = app_test_support::rollout_path(other_home.path(), timestamp, &saved);
+        std::fs::create_dir_all(destination.parent().unwrap())?;
+        std::fs::copy(source, destination)?;
+        let (mut origin, origin_requests, origin_proxy) = start_recording_app_server_with_history(
+            &app.config,
+            HistoryCapabilities::Current,
+            None,
+            None,
+            ThreadParamsMode::Embedded,
+            LoaderOverrides::without_managed_config_for_tests(),
+        )
+        .await?;
+        let (mut other, other_requests, other_proxy) = start_recording_app_server_with_history(
+            &other_config,
+            HistoryCapabilities::Current,
+            None,
+            None,
+            ThreadParamsMode::Embedded,
+            LoaderOverrides::without_managed_config_for_tests(),
+        )
+        .await?;
+        assert_ne!(origin.backend_id(), other.backend_id());
+        let original = origin
+            .resume_thread(
+                &app.local_settings,
+                app.config.clone(),
+                id,
+                ResumeModelSettings::PreserveExistingThread,
+            )
+            .await?;
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        app.replace_chat_widget_with_app_server_thread(
+            &mut tui,
+            original,
+            ThreadAttachPresentation::SessionLineage,
+            None,
+        )
+        .await?;
+        app.chat_widget.set_model("gpt-5.4");
+        set_fast_mode_test_catalog(&mut app.chat_widget);
+        app.chat_widget.set_feature_enabled(Feature::FastMode, true);
+        let owner = app.chat_widget.thread_runtime_generation;
+        let queued = queued_runtime_command(&mut app, &mut events, command);
+        let replacement = if switch_backend {
+            other
+                .resume_thread(
+                    &crate::local_settings::LocalSettings::from(&other_config),
+                    other_config,
+                    id,
+                    ResumeModelSettings::PreserveExistingThread,
+                )
+                .await?
+        } else {
+            origin.start_thread(&app.config).await?
+        };
+        if switch_backend {
+            assert!(
+                !replacement.blocks_direct_input,
+                "replacement runtime must be writable"
+            );
+            assert_eq!(
+                replacement.session.thread_id, id,
+                "both native backends loaded the same UUID"
+            );
+        }
+        app.replace_chat_widget_with_app_server_thread(
+            &mut tui,
+            replacement,
+            ThreadAttachPresentation::SessionLineage,
+            None,
+        )
+        .await?;
+        assert_ne!(app.chat_widget.thread_runtime_generation, owner);
+        app.chat_widget
+            .restore_user_message_to_composer("keep replacement draft".into());
+        origin_requests.lock().unwrap().clear();
+        other_requests.lock().unwrap().clear();
+        while events.try_recv().is_ok() {}
+        let displayed_server = if switch_backend {
+            &mut other
+        } else {
+            &mut origin
+        };
+        app.handle_event(&mut tui, displayed_server, queued).await?;
+        assert!(origin_requests.lock().unwrap().is_empty());
+        assert!(other_requests.lock().unwrap().is_empty());
+        assert_eq!(
+            app.chat_widget.composer_text_with_pending(),
+            "keep replacement draft"
+        );
+        let history = next_history_message(&mut events);
+        assert!(history.contains(stale_error));
+        assert!(!history.contains("Service tier set"));
+        assert!(!history.contains("Reloaded plugin configuration"));
+        origin_proxy.abort();
+        other_proxy.abort();
+    }
+    Ok(())
+}
diff --git a/codex-rs/tui/src/app/tests/service_tier_session_tests.rs b/codex-rs/tui/src/app/tests/service_tier_session_tests.rs
new file mode 100644
index 000000000..c52c04af1
--- /dev/null
+++ b/codex-rs/tui/src/app/tests/service_tier_session_tests.rs
@@ -0,0 +1,235 @@
+//! Tier selection preserves user defaults and independent root conversations. Core
+//! intentionally propagates a root tier to its agent tree; that existing inheritance is unchanged.
+
+use super::session_lifecycle_requests::{
+    HistoryCapabilities, recorded_params, start_recording_app_server_with_history,
+};
+use super::*;
+use crate::app_server_session::{ResumeModelSettings, ThreadParamsMode};
+use codex_protocol::config_types::SERVICE_TIER_DEFAULT_REQUEST_VALUE;
+use pretty_assertions::assert_eq;
+
+fn prepare_fast_widget(app: &mut App) {
+    app.chat_widget.set_model("gpt-5.4");
+    set_fast_mode_test_catalog(&mut app.chat_widget);
+    app.chat_widget.set_feature_enabled(Feature::FastMode, true);
+    app.chat_widget.set_service_tier(Some("flex".into()));
+}
+
+async fn drain_selection(
+    app: &mut App,
+    server: &mut AppServerSession,
+    events: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) -> Result<String> {
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let mut messages = Vec::new();
+    while let Ok(event) = events.try_recv() {
+        if let AppEvent::InsertHistoryCell(cell) = &event {
+            messages.push(lines_to_single_string(&cell.transcript_lines(200)));
+        }
+        Box::pin(app.handle_event(&mut tui, server, event)).await?;
+    }
+    Ok(messages.join("\n"))
+}
+
+fn assert_no_global_or_turn_mutations(
+    requests: &super::session_lifecycle_requests::RecordedRequests,
+) {
+    for method in [
+        "config/batchWrite",
+        "config/value/write",
+        "config/mcpServer/reload",
+        "turn/start",
+        "turn/steer",
+        "turn/interrupt",
+    ] {
+        assert!(recorded_params(requests, method).is_empty(), "{method}");
+    }
+}
+
+#[tokio::test]
+async fn fast_selection_preserves_global_defaults_other_threads_and_permissions() -> Result<()> {
+    let (mut app, mut events, _) = make_test_app_with_channels().await;
+    app.config.model = Some("gpt-5.4".into());
+    app.config.model_reasoning_effort = Some(ReasoningEffortConfig::Medium);
+    app.config.service_tier = Some("flex".into());
+    let file = app.config.codex_home.join("config.toml");
+    let original = "# Explicit defaults must survive a session selection.\nmodel = 'gpt-5.4'\nmodel_reasoning_effort = 'medium'\nservice_tier = 'flex'\n";
+    std::fs::write(&file, original)?;
+    let (mut server, requests, proxy) = start_recording_app_server_with_history(
+        &app.config,
+        HistoryCapabilities::Current,
+        None,
+        None,
+        ThreadParamsMode::Embedded,
+        LoaderOverrides::without_managed_config_for_tests(),
+    )
+    .await?;
+    let selected = server.start_thread(&app.config).await?;
+    let before = selected.session.clone();
+    let other = server.start_thread(&app.config).await?.session;
+    // A new empty thread has a lazy rollout. Persist real history before testing resume.
+    server
+        .thread_inject_items(
+            other.thread_id,
+            vec![serde_json::from_value(serde_json::json!({
+                "type": "message", "role": "assistant",
+                "content": [{"type": "output_text", "text": "Independent conversation fixture"}]
+            }))?],
+        )
+        .await?;
+    let id = before.thread_id;
+    app.enqueue_primary_thread_session(selected.session, selected.turns)
+        .await?;
+    prepare_fast_widget(&mut app);
+    let permissions = RuntimePermissionProfileOverride::from_config(app.chat_widget.config_ref());
+    app.keymap.app.toggle_fast_mode = vec![
+        crate::key_hint::ctrl(KeyCode::Char('f')),
+        crate::key_hint::alt(KeyCode::Char('f')),
+    ];
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    for (modifiers, expected_tier) in [
+        (KeyModifiers::CONTROL, ServiceTier::Fast.request_value()),
+        (KeyModifiers::ALT, SERVICE_TIER_DEFAULT_REQUEST_VALUE),
+    ] {
+        while events.try_recv().is_ok() {}
+        requests.lock().unwrap().clear();
+        let previous = app.chat_widget.configured_service_tier();
+        Box::pin(app.handle_tui_event(
+            &mut tui,
+            &mut server,
+            TuiEvent::Key(KeyEvent::new(KeyCode::Char('f'), modifiers)),
+        ))
+        .await?;
+        assert_eq!(
+            app.chat_widget.configured_service_tier(),
+            previous,
+            "selection must await Core acceptance"
+        );
+        let messages = drain_selection(&mut app, &mut server, &mut events).await?;
+        assert!(messages.contains("for this conversation only"));
+        let updates = recorded_params(&requests, "thread/settings/update");
+        assert_eq!(updates.len(), 1);
+        assert_eq!(updates[0]["threadId"], id.to_string());
+        assert_eq!(updates[0]["serviceTier"], expected_tier);
+        for (key, value) in updates[0].as_object().unwrap() {
+            if key != "threadId" && key != "serviceTier" {
+                assert!(value.is_null(), "unexpected override: {key}");
+            }
+        }
+        assert_no_global_or_turn_mutations(&requests);
+        let updated = next_thread_settings_updated(&mut server, id)
+            .await
+            .thread_settings;
+        assert_eq!(updated.service_tier.as_deref(), Some(expected_tier));
+        assert_eq!(updated.model, before.model);
+        assert_eq!(updated.effort, before.reasoning_effort);
+        assert_eq!(updated.approval_policy, before.approval_policy);
+        assert_eq!(
+            updated.approvals_reviewer.to_core(),
+            before.approvals_reviewer
+        );
+        assert_eq!(updated.cwd, before.cwd);
+        assert_eq!(
+            updated.active_permission_profile,
+            before.active_permission_profile.clone().map(Into::into)
+        );
+        assert_eq!(
+            PermissionProfile::from_legacy_sandbox_policy_for_cwd(
+                &updated.sandbox_policy.to_core(),
+                updated.cwd.as_path()
+            ),
+            before.permission_profile
+        );
+        assert_eq!(
+            RuntimePermissionProfileOverride::from_config(app.chat_widget.config_ref()),
+            permissions
+        );
+        assert_eq!(app.chat_widget.current_service_tier(), Some(expected_tier));
+        assert_eq!(
+            app.primary_session_configured
+                .as_ref()
+                .unwrap()
+                .service_tier
+                .as_deref(),
+            Some(expected_tier)
+        );
+        assert_eq!(app.config.service_tier.as_deref(), Some("flex"));
+        assert_eq!(std::fs::read(&file)?, original.as_bytes());
+    }
+    let other_after = server
+        .resume_thread(
+            &app.local_settings,
+            app.config.clone(),
+            other.thread_id,
+            ResumeModelSettings::PreserveExistingThread,
+        )
+        .await?
+        .session;
+    assert_eq!(other_after.service_tier, other.service_tier);
+    assert_eq!(other_after.model, other.model);
+    assert_eq!(other_after.permission_profile, other.permission_profile);
+    let fresh = server.start_thread(&app.config).await?.session;
+    assert_eq!(fresh.service_tier.as_deref(), Some("flex"));
+    assert_eq!(fresh.model, before.model);
+    assert_eq!(std::fs::read(&file)?, original.as_bytes());
+    proxy.abort();
+    Ok(())
+}
+
+#[tokio::test]
+async fn fast_selection_failure_unsupported_queue_ack_and_lost_reply_preserve_local_state()
+-> Result<()> {
+    for capability in [
+        HistoryCapabilities::ThreadSettingsUpdateUnsupported,
+        HistoryCapabilities::ThreadSettingsUpdateFails,
+        HistoryCapabilities::ThreadSettingsUpdateQueueOnly,
+        HistoryCapabilities::ThreadSettingsUpdateReplyLost,
+        HistoryCapabilities::ThreadSettingsUpdateUnconfirmed,
+        HistoryCapabilities::ThreadSettingsUpdateMalformed,
+    ] {
+        let (mut app, mut events, _) = make_test_app_with_channels().await;
+        app.config.model = Some("gpt-5.4".into());
+        app.config.service_tier = Some("flex".into());
+        let file = app.config.codex_home.join("config.toml");
+        let original = "service_tier = 'flex'\n";
+        std::fs::write(&file, original)?;
+        let (mut server, requests, proxy) = start_recording_app_server_with_history(
+            &app.config,
+            capability,
+            None,
+            None,
+            ThreadParamsMode::Embedded,
+            LoaderOverrides::without_managed_config_for_tests(),
+        )
+        .await?;
+        let started = server.start_thread(&app.config).await?;
+        app.enqueue_primary_thread_session(started.session, started.turns)
+            .await?;
+        prepare_fast_widget(&mut app);
+        let cache_before = app.primary_session_configured.clone();
+        while events.try_recv().is_ok() {}
+        requests.lock().unwrap().clear();
+        app.chat_widget.toggle_fast_mode_from_ui();
+        app.chat_widget
+            .apply_external_edit("follow-up after tier selection".into());
+        app.chat_widget.handle_key_event(KeyCode::Enter.into());
+        assert!(app.chat_widget.has_queued_follow_up_messages());
+        let messages = drain_selection(&mut app, &mut server, &mut events).await?;
+        assert!(!messages.contains("Service tier set"));
+        assert!(messages.contains("retained"));
+        assert_eq!(app.chat_widget.current_service_tier(), Some("flex"));
+        assert_eq!(app.primary_session_configured, cache_before);
+        assert_eq!(app.config.service_tier.as_deref(), Some("flex"));
+        assert_eq!(std::fs::read(&file)?, original.as_bytes());
+        assert_eq!(
+            recorded_params(&requests, "thread/settings/update").len(),
+            1
+        );
+        assert_no_global_or_turn_mutations(&requests);
+        assert!(app.chat_widget.has_queued_follow_up_messages());
+        assert!(!app.chat_widget.maybe_send_next_queued_input());
+        proxy.abort();
+    }
+    Ok(())
+}
