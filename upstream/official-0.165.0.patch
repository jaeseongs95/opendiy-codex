+        );
+        assert_eq!(
+            response.origins["features.memories"].name,
+            ConfigLayerSource::SessionFlags
+        );
+        for exact in ["allow_login_shell", "feedback.enabled"] {
+            assert!(
+                !response.origins.contains_key(exact),
