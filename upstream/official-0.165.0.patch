+                    }
+                }
+            }
+            next = next_index(turns)
+                .map(|index| turns[index].id.clone())
+                .or(first_new);
+        }
+        let more_metadata = if newer {
+            state.newer_turn_cursor.is_some()
+        } else {
+            state.next_turn_cursor.is_some()
+        };
