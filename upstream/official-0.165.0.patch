+            thread_id: "thread-root".into(),
+        })?;
+        let trace = InferenceTraceContext::enabled(
+            writer,
+            "thread-root".into(),
+            "turn-1".into(),
+            "gpt-test".into(),
+            "test-provider".into(),
+        );
+        let error = match session
