+                TEST_CONNECTION_ID,
+                status,
+                &AppServerTransport::Stdio,
+                Arc::clone(&harness.session),
+            )
+            .await;
+        let cancel: JSONRPCRequest = serde_json::from_value(serde_json::json!({
+            "id": 992,
+            "method": "hotfix/mcpRead/cancel",
+            "params": {"requestId": 991}
+        }))?;
