+        .await;
+    assert_eq!(idle.load(Ordering::SeqCst), 1);
+    drop(rx);
+    processor.clear_runtime_references();
+    manager.shutdown_all_threads_bounded(DEADLINE).await;
+    processor.shutdown_threads().await;
+    Ok(())
+}
