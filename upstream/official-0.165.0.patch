+            "add --every 10m -- 확인 -- 그대로"
+        );
+        for value in [
+            json!({"action":"add","every":"10m","at":"2030-01-01T00:00:00+09:00","prompt":"확인"}),
+            json!({"action":"add","every":"10m -- 주입","prompt":"확인"}),
+            json!({"action":"list","threadId":"다른 대화"}),
+            json!({"action":"remove","id":0}),
