+    app.ensure_thread_channel(caller_b)
+        .store
+        .lock()
+        .await
+        .set_session(started_b.session, started_b.turns);
+    let connection_b = session_b.cron_tool_connection();
+    let server_b = Arc::new(
+        DynamicToolMcpServer::start(
+            session_b.request_handle(),
