+    loop {
+        if sess.services.model_client.auth_owner_generation() != owner {
+            return;
+        }
+        if changes.changed().await.is_err() {
+            return;
+        }
+        // Refresh notifications must yield so stop/new-input futures can still be polled.
+        tokio::task::yield_now().await;
+    }
