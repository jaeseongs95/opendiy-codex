+        if let Err(error) = &content
+            && error.kind() == io::ErrorKind::InvalidData
+        {
+            return Err(io::Error::new(error.kind(), error.to_string()));
+        }
+        contents.insert(file.source_path.clone(), content);
+    }
+    Ok(contents)
+}
