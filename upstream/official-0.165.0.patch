+        assert_eq!(
+            loader.calls.load(Ordering::SeqCst),
+            1,
+            "one load per config/read"
+        );
+        assert_eq!(response.config.model.as_deref(), Some("cli-model"));
+        assert_eq!(
+            response.config.additional["features"]["memories"],
