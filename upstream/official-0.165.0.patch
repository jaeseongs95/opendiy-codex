+            app.app_event_tx.clone(),
+            app.dynamic_tool_status_updates.clone(),
+            None,
+            ToolServices {
+                task_tools: true,
+                cron: Some(connection_b.clone()),
+                worktrees: None,
+            },
+        )
+        .await?,
+    );
+    let transport_b = ThreadToolTransport::Mcp(Arc::clone(&server_b));
