+        let mut lines: Vec<serde_json::Value> = contents
+            .lines()
+            .map(serde_json::from_str)
+            .collect::<Result<_, _>>()?;
+        lines[0]["payload"]["cwd"] = json!(if foreign { &a } else { &b });
+        lines.insert(
+            1,
+            json!({"timestamp":"2026-10-12T00:00:00Z", "type":"event_msg", "payload":event}),
+        );
