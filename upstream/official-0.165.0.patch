+        let account = AccountRequestProcessor::new(
+            Arc::clone(&auth),
+            Arc::clone(&threads),
+            Arc::clone(&outgoing),
+            Arc::clone(&config),
+            manager.clone(),
+            catalog,
+        );
+        Ok(Self {
