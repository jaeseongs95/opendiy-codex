+    );
+    assert!(
+        app.thread_event_channels[&registered]
+            .store
+            .lock()
+            .await
+            .pending_replay_requests()
+            .is_empty()
+    );
+    origin.shutdown().await?;
+    other_backend.shutdown().await?;
+    origin_task.await??;
+    other_task.await??;
+    Ok(())
+}
