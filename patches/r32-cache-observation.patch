+            !value.is_empty()
+                && value.len() <= limit
+                && value.bytes().all(|byte| {
+                    byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-' | b'.' | b'/' | b':')
+                })
+        }
+        _ => false,
+    }
